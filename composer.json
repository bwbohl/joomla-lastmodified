{
    "name": "bwbohl/joomla-lastmodified",
    "description": "Joomla content plugin that replaces {lastmodified} with the year of the last article update",
    "type": "joomla-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Benjamin W. Bohl",
            "email": "b.w.bohl@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "joomla/coding-standards": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Bwbohl\\Plugin\\Content\\LastModified\\": "src/"
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
